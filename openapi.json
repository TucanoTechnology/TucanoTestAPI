{
  "openapi": "3.0.3",
  "info": {
    "title": "Tucano Test API",
    "version": "0.1.0",
    "description": "File-based test case management API. Data is stored as JSON files; no database is used."
  },
  "servers": [{"url": "http://localhost:3000"}],
  "paths": {
    "/health": {"get": {"summary": "Health check", "responses": {"200": {"description": "Service is healthy"}}}},
    "/openapi.json": {"get": {"summary": "OpenAPI document", "responses": {"200": {"description": "OpenAPI JSON"}}}},
    "/api-docs": {"get": {"summary": "Swagger UI", "responses": {"200": {"description": "Interactive API documentation"}}}},
    "/projects": {"$ref": "#/components/x-crud"},
    "/projects/{id}": {"$ref": "#/components/x-resource"},
    "/test_suites": {"$ref": "#/components/x-crud"},
    "/test_suites/{id}": {"$ref": "#/components/x-resource"},
    "/test_suites/{id}/test_cases": {"post": {"summary": "Add test case to suite", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"testCaseId": {"type": "string"}}, "required": ["testCaseId"]}}}}, "responses": {"200": {"description": "Added"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_suites/{id}/test_cases/{case_id}": {"delete": {"summary": "Remove test case from suite", "parameters": [{"$ref": "#/components/parameters/id"}, {"name": "case_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Removed"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/test_runs": {"$ref": "#/components/x-crud"},
    "/test_runs/{id}": {"$ref": "#/components/x-resource"},
    "/test_runs/{id}/test_suites": {"post": {"summary": "Add test suite to run", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"suiteId": {"type": "string"}}, "required": ["suiteId"]}}}}, "responses": {"200": {"description": "Added"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_runs/{id}/test_cases": {"post": {"summary": "Add test case to run", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"testCaseId": {"type": "string"}}, "required": ["testCaseId"]}}}}, "responses": {"200": {"description": "Added"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_runs/{id}/results": {"post": {"summary": "Record test case execution result in run", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestCaseResult"}}}}, "responses": {"200": {"description": "Recorded"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/test_cases": {"$ref": "#/components/x-crud"},
    "/test_cases/{id}": {"$ref": "#/components/x-resource"},
    "/test_cases/{id}/attachments": {"post": {"summary": "Upload attachment", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/AttachmentUpload"}}}}, "responses": {"201": {"description": "Uploaded"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/test_cases/{id}/attachments/{filename}": {"get": {"summary": "Download attachment", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/filename"}], "responses": {"200": {"description": "File content", "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "404": {"$ref": "#/components/responses/Error"}}}, "delete": {"summary": "Delete attachment", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/filename"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/milestones": {"$ref": "#/components/x-crud"},
    "/milestones/{id}": {"$ref": "#/components/x-resource"},
    "/milestones/{id}/progress": {"get": {"summary": "Get milestone progress", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Milestone progress summary", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MilestoneProgress"}}}}, "404": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "x-crud": {"get": {"summary": "List resources", "parameters": [{"$ref": "#/components/parameters/filter"}], "responses": {"200": {"description": "Resource IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}}}, "post": {"summary": "Create resource", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "x-resource": {"get": {"summary": "Read resource", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Resource JSON"}, "404": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update resource", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "404": {"$ref": "#/components/responses/Error"}}}, "delete": {"summary": "Delete resource", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "parameters": {"id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, "filename": {"name": "filename", "in": "path", "required": true, "schema": {"type": "string"}}, "filter": {"name": "filter", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Case-insensitive substring filter for resource IDs"}},
    "schemas": {"AttachmentUpload": {"type": "object", "properties": {"file": {"type": "string", "format": "binary"}}, "required": ["file"]}, "TestStep": {"type": "object", "properties": {"action": {"type": "string"}, "expectedResult": {"type": "string"}}, "required": ["action"]}, "TestCase": {"type": "object", "properties": {"testCaseId": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "preconditions": {"type": "string"}, "steps": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/components/schemas/TestStep"}]}}, "expectedResult": {"type": "string"}, "priority": {"type": "string", "enum": ["Low", "Medium", "High", "Critical"]}, "severity": {"type": "string", "enum": ["Trivial", "Minor", "Major", "Critical"]}, "testType": {"type": "string"}, "exploratory": {"type": "boolean"}}, "required": ["testCaseId", "title", "expectedResult"]}, "TestCaseResult": {"type": "object", "properties": {"testCaseId": {"type": "string"}, "status": {"type": "string", "enum": ["Passed", "Failed", "Blocked", "Untested", "Retest"]}, "timestamp": {"type": "string", "format": "date-time"}, "notes": {"type": "string"}}, "required": ["testCaseId", "status", "timestamp"]}, "Milestone": {"type": "object", "properties": {"milestoneId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "startDate": {"type": "string", "format": "date"}, "targetDate": {"type": "string", "format": "date"}, "status": {"type": "string"}, "testSuiteIds": {"type": "array", "items": {"type": "string"}}, "testRunIds": {"type": "array", "items": {"type": "string"}}}, "required": ["milestoneId", "name"]}, "MilestoneProgress": {"type": "object", "properties": {"milestoneId": {"type": "string"}, "totalCases": {"type": "integer"}, "passed": {"type": "integer"}, "failed": {"type": "integer"}, "blocked": {"type": "integer"}, "untested": {"type": "integer"}, "retest": {"type": "integer"}, "passPercentage": {"type": "number"}}, "required": ["milestoneId", "totalCases", "passed", "failed", "blocked", "untested", "retest", "passPercentage"]}, "Error": {"type": "object", "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}},
    "responses": {"Error": {"description": "Structured error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}
  }
}
