{
  "openapi": "3.0.3",
  "info": {
    "title": "Tucano Test API",
    "version": "0.1.0",
    "description": "File-based test case management API. Data is stored as JSON files; no database is used."
  },
  "servers": [{"url": "http://localhost:3000"}],
  "paths": {
    "/health": {"get": {"summary": "Health check", "responses": {"200": {"description": "Service is healthy"}}}},
    "/openapi.json": {"get": {"summary": "OpenAPI document", "responses": {"200": {"description": "OpenAPI JSON"}}}},
    "/api-docs": {"get": {"summary": "Swagger UI", "responses": {"200": {"description": "Interactive API documentation"}}}},
    "/projects": {"$ref": "#/components/x-crud"},
    "/projects/{id}": {"get": {"summary": "Read a project, assembling the suites and directly owned cases it holds", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Project document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Project"}}}}, "404": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a project", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}, "delete": {"summary": "Delete a project and everything below it", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/projects/{id}/duplicate": {"$ref": "#/components/x-duplicate"},
    "/projects/{id}/test_suites": {"get": {"summary": "List the test suites a project owns", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test suite IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}, "404": {"$ref": "#/components/responses/Error"}}}, "post": {"summary": "Create a test suite in a project, or place an existing one", "description": "A body with a non-empty `name` creates a suite (identifier `<name>.json` unless `suiteId` is given). A body naming an existing `suiteId` and nothing else places that suite here.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionRequest"}}}}, "responses": {"201": {"description": "Created, copied, or moved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/projects/{id}/test_suites/{suite_id}": {"delete": {"summary": "Delete a test suite a project owns", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/suite_id"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/projects/{id}/test_cases": {"get": {"summary": "List the test cases a project directly owns", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test case IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}, "404": {"$ref": "#/components/responses/Error"}}}, "post": {"summary": "Create a test case in a project, or place an existing one", "description": "A body carrying a `title` (with the `testCaseId` and `expectedResult` a case needs) creates a case. A body naming an existing `testCaseId` and nothing else places that case here.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionRequest"}}}}, "responses": {"201": {"description": "Created, copied, or moved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/projects/{id}/test_cases/{case_id}": {"delete": {"summary": "Delete a test case a project owns", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/case_id"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/test_suites/{id}": {"get": {"summary": "Read a test suite with the cases it holds assembled", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test suite document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestSuite"}}}}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a test suite", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "delete": {"summary": "Delete a test suite and the cases it holds", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_suites/{id}/duplicate": {"$ref": "#/components/x-duplicate"},
    "/test_suites/{id}/test_cases": {"get": {"summary": "List the test cases a suite holds", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test case IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "post": {"summary": "Create a test case in a suite, or place an existing one", "description": "A body carrying a `title` (with the `testCaseId` and `expectedResult` a case needs) creates a case in the suite. A body naming an existing `testCaseId` and nothing else places that case here.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionRequest"}}}}, "responses": {"201": {"description": "Created, copied, or moved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_suites/{id}/test_cases/{case_id}": {"delete": {"summary": "Remove a test case from a suite", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/case_id"}], "responses": {"200": {"description": "Removed"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_runs": {"$ref": "#/components/x-crud"},
    "/test_runs/{id}": {"$ref": "#/components/x-resource"},
    "/test_runs/{id}/duplicate": {"$ref": "#/components/x-duplicate-run"},
    "/test_runs/{id}/test_suites": {"post": {"summary": "Add test suite to run", "description": "A run is a point-in-time snapshot, never a home: the suite is recorded as a copy and keeps the project that owns it, so this does not relocate the source.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"suiteId": {"type": "string"}}, "required": ["suiteId"]}}}}, "responses": {"200": {"description": "Added"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_runs/{id}/test_cases": {"post": {"summary": "Add test case to run", "description": "A run is a point-in-time snapshot, never a home: the case is recorded as a copy and keeps the project or suite that owns it, so this does not relocate the source.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"testCaseId": {"type": "string"}}, "required": ["testCaseId"]}}}}, "responses": {"200": {"description": "Added"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_runs/{id}/results": {"post": {"summary": "Record test case execution result in run", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestCaseResult"}}}}, "responses": {"200": {"description": "Recorded"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/test_cases/{id}": {"get": {"summary": "Read a test case", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead.", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test case document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestCase"}}}}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a test case", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "delete": {"summary": "Delete a test case", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead.", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_cases/{id}/duplicate": {"$ref": "#/components/x-duplicate-case"},
    "/test_cases/{id}/attachments": {"post": {"summary": "Upload attachment", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/AttachmentUpload"}}}}, "responses": {"201": {"description": "Uploaded"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_cases/{id}/attachments/{filename}": {"get": {"summary": "Download attachment", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/filename"}], "responses": {"200": {"description": "File content", "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "delete": {"summary": "Delete attachment", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/filename"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/milestones": {"$ref": "#/components/x-crud"},
    "/milestones/{id}": {"$ref": "#/components/x-resource"},
    "/milestones/{id}/progress": {"get": {"summary": "Get milestone progress", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Milestone progress summary", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MilestoneProgress"}}}}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/configurations": {"$ref": "#/components/x-crud"},
    "/configurations/{id}": {"$ref": "#/components/x-resource"}
  },
  "components": {
    "x-crud": {"get": {"summary": "List resources", "parameters": [{"$ref": "#/components/parameters/filter"}, {"$ref": "#/components/parameters/tags"}], "responses": {"200": {"description": "Resource IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}}}, "post": {"summary": "Create resource", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "x-resource": {"get": {"summary": "Read resource", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Resource JSON"}, "404": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update resource", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}, "delete": {"summary": "Delete resource", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "x-duplicate": {"post": {"summary": "Duplicate resource", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DuplicateRequest"}}}}, "responses": {"201": {"description": "Duplicated"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "x-duplicate-case": {"post": {"summary": "Duplicate test case", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DuplicateCaseRequest"}}}}, "responses": {"201": {"description": "Duplicated"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "x-duplicate-run": {"post": {"summary": "Duplicate test run without its results", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DuplicateRunRequest"}}}}, "responses": {"201": {"description": "Duplicated"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "parameters": {"id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, "filename": {"name": "filename", "in": "path", "required": true, "schema": {"type": "string"}}, "suite_id": {"name": "suite_id", "in": "path", "required": true, "schema": {"type": "string"}}, "case_id": {"name": "case_id", "in": "path", "required": true, "schema": {"type": "string"}}, "filter": {"name": "filter", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Case-insensitive substring filter for resource IDs"}, "tags": {"name": "tags", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Comma-separated tags; a resource matches when it carries at least one of them (case-insensitive). Resources without a tags array never match."}},
    "schemas": {"DuplicateRequest": {"type": "object", "properties": {"newId": {"type": "string", "description": "Identifier for the copy; derived from the source when omitted"}, "newName": {"type": "string", "description": "Name for the copy; the source name is kept when omitted"}}}, "DuplicateCaseRequest": {"type": "object", "properties": {"newId": {"type": "string", "description": "Identifier for the copy; derived from the source when omitted"}, "newTitle": {"type": "string", "description": "Title for the copy; the source title is kept when omitted"}}}, "DuplicateRunRequest": {"type": "object", "properties": {"newId": {"type": "string", "description": "Identifier for the copy; derived from the source when omitted"}}}, "AttachmentUpload": {"type": "object", "properties": {"file": {"type": "string", "format": "binary"}}, "required": ["file"]}, "TestStep": {"type": "object", "properties": {"action": {"type": "string"}, "expectedResult": {"type": "string"}}, "required": ["action"]}, "TestCase": {"type": "object", "properties": {"testCaseId": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "preconditions": {"type": "string"}, "steps": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/components/schemas/TestStep"}]}}, "expectedResult": {"type": "string"}, "priority": {"type": "string", "enum": ["Low", "Medium", "High", "Critical"]}, "severity": {"type": "string", "enum": ["Trivial", "Minor", "Major", "Critical"]}, "testType": {"type": "string"}, "exploratory": {"type": "boolean"}}, "required": ["testCaseId", "title", "expectedResult"]}, "TestCaseResult": {"type": "object", "properties": {"testCaseId": {"type": "string"}, "status": {"type": "string", "enum": ["Passed", "Failed", "Blocked", "Untested", "Retest"]}, "timestamp": {"type": "string", "format": "date-time"}, "notes": {"type": "string"}}, "required": ["testCaseId", "status", "timestamp"]}, "Milestone": {"type": "object", "properties": {"milestoneId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "startDate": {"type": "string", "format": "date"}, "targetDate": {"type": "string", "format": "date"}, "status": {"type": "string"}, "testSuiteIds": {"type": "array", "items": {"type": "string"}}, "testRunIds": {"type": "array", "items": {"type": "string"}}}, "required": ["milestoneId", "name"]}, "MilestoneProgress": {"type": "object", "properties": {"milestoneId": {"type": "string"}, "totalCases": {"type": "integer"}, "passed": {"type": "integer"}, "failed": {"type": "integer"}, "blocked": {"type": "integer"}, "untested": {"type": "integer"}, "retest": {"type": "integer"}, "passPercentage": {"type": "number"}}, "required": ["milestoneId", "totalCases", "passed", "failed", "blocked", "untested", "retest", "passPercentage"]}, "TestConfiguration": {"type": "object", "properties": {"configId": {"type": "string"}, "name": {"type": "string"}, "browser": {"type": "string"}, "os": {"type": "string"}, "device": {"type": "string"}, "resolution": {"type": "string"}}, "required": ["configId", "name"]}, "TestSuite": {"type": "object", "description": "A test suite document. The stored marker keeps `testCases` empty; reads fill it with the cases the suite folder holds.", "properties": {"suiteId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "testCases": {"type": "array", "items": {"$ref": "#/components/schemas/TestCase"}}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["suiteId", "name"]}, "Project": {"type": "object", "description": "A project document. Reads replace `testSuites` with the suites the project holds (each carrying its cases) and add `testCases` for the cases held directly — a response-only field, omitted when the project owns no case directly.", "properties": {"projectId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "testSuites": {"type": "array", "items": {"$ref": "#/components/schemas/TestSuite"}}, "testCases": {"type": "array", "items": {"$ref": "#/components/schemas/TestCase"}}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["projectId", "name"]}, "CompositionRequest": {"type": "object", "description": "Creation-or-placement body shared by the parent-scoped collection routes. Carry the fields a new child needs (`name` for a suite; `testCaseId` and `title` for a case) to create, or name an existing `suiteId`/`testCaseId` and nothing else to place that child here. Mixing the two forms is a 400.", "properties": {"name": {"type": "string", "description": "Creation: the suite name; the identifier is `<name>.json` unless `suiteId` is also given"}, "suiteId": {"type": "string", "description": "Creation: the suite identifier. Placement: the existing suite to copy or move here"}, "title": {"type": "string", "description": "Creation: the case title"}, "testCaseId": {"type": "string", "description": "Creation: the case identifier. Placement: the existing case to copy or move here"}, "expectedResult": {"type": "string", "description": "Creation: the result the case expects"}, "mode": {"type": "string", "enum": ["copy", "move"], "default": "copy", "description": "Placement only: `copy` duplicates the child into this parent and keeps the source in place (the default); `move` relocates it"}}}, "CompositionResponse": {"type": "object", "properties": {"message": {"type": "string"}, "id": {"type": "string"}}, "required": ["message", "id"]}, "Error": {"type": "object", "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}},
    "responses": {"Error": {"description": "Structured error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}
  }
}
