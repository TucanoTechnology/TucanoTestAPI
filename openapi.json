{
  "openapi": "3.0.3",
  "info": {
    "title": "Tucano Test API",
    "version": "0.1.0",
    "description": "File-based test case management API. Data is stored as JSON files; no database is used."
  },
  "servers": [{"url": "http://localhost:3000"}],
  "paths": {
    "/health": {"get": {"summary": "Health check", "responses": {"200": {"description": "Service is healthy"}}}},
    "/openapi.json": {"get": {"summary": "OpenAPI document", "responses": {"200": {"description": "OpenAPI JSON"}}}},
    "/api-docs": {"get": {"summary": "Swagger UI", "responses": {"200": {"description": "Interactive API documentation"}}}},
    "/projects": {"get": {"summary": "List projects", "parameters": [{"$ref": "#/components/parameters/filter"}, {"$ref": "#/components/parameters/tags"}], "responses": {"200": {"description": "Project IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}}}, "post": {"summary": "Create a project", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/projects/{id}": {"get": {"summary": "Read a project, assembling the suites and directly owned cases it holds", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Project document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Project"}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a project", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}, "delete": {"summary": "Delete a project and everything below it", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/projects/{id}/duplicate": {"$ref": "#/components/x-duplicate"},
    "/projects/{id}/test_suites": {"get": {"summary": "List the test suites a project owns", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test suite IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}, "post": {"summary": "Create a test suite in a project, or place an existing one", "description": "A body with a non-empty `name` creates a suite, identified as `<name>.json`. Otherwise the body names an existing `suiteId` to place here, and `mode` chooses copy (the default) or move.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionRequest"}}}}, "responses": {"201": {"description": "Created, copied, or moved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionResponse"}}}}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/projects/{id}/test_suites/{suite_id}": {"delete": {"summary": "Delete a test suite a project owns", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/suite_id"}], "responses": {"200": {"description": "Deleted"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/projects/{id}/test_cases": {"get": {"summary": "List the test cases a project directly owns", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test case IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}, "post": {"summary": "Create a test case in a project, or place an existing one", "description": "A body carrying a `title` creates a case and must also carry the `testCaseId` and `expectedResult` a case needs. Otherwise the body names an existing `testCaseId` to place here, and `mode` chooses copy (the default) or move.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionRequest"}}}}, "responses": {"201": {"description": "Created, copied, or moved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionResponse"}}}}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/projects/{id}/test_cases/{case_id}": {"delete": {"summary": "Delete a test case a project owns", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/case_id"}], "responses": {"200": {"description": "Deleted"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/test_suites/{id}": {"get": {"summary": "Read a test suite with the cases it holds assembled", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test suite document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestSuite"}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a test suite", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}, "delete": {"summary": "Delete a test suite and the cases it holds", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_suites/{id}/duplicate": {"$ref": "#/components/x-duplicate-suite"},
    "/test_suites/{id}/test_cases": {"get": {"summary": "List the test cases a suite holds", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test case IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "post": {"summary": "Create a test case in a suite, or place an existing one", "description": "A body carrying a `title` creates a case in the suite and must also carry the `testCaseId` and `expectedResult` a case needs. Otherwise the body names an existing `testCaseId` to place here, and `mode` chooses copy (the default) or move.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionRequest"}}}}, "responses": {"201": {"description": "Created, copied, or moved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompositionResponse"}}}}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/test_suites/{id}/test_cases/{case_id}": {"delete": {"summary": "Remove a test case from a suite", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/case_id"}], "responses": {"200": {"description": "Removed"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_runs": {"get": {"summary": "List test runs", "description": "A run is a point-in-time snapshot. `filter` and `tags` behave as they do elsewhere; `configuration` is meaningful here alone and keeps the runs that link the given configuration, so a configuration no run links yields an empty listing.", "parameters": [{"$ref": "#/components/parameters/filter"}, {"$ref": "#/components/parameters/tags"}, {"$ref": "#/components/parameters/configuration"}], "responses": {"200": {"description": "Test run IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}}}, "post": {"summary": "Create a test run", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/test_runs/{id}": {"get": {"summary": "Read a test run", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test run document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestRun"}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a test run", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}, "delete": {"summary": "Delete a test run", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/test_runs/{id}/duplicate": {"$ref": "#/components/x-duplicate-run"},
    "/test_runs/{id}/test_suites": {"post": {"summary": "Add test suite to run", "description": "A run is a point-in-time snapshot, never a home: the suite is recorded as a copy and keeps the project that owns it, so this does not relocate the source. An unusable path identifier or `suiteId` answers `invalid_id`.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"suiteId": {"type": "string"}}, "required": ["suiteId"]}}}}, "responses": {"200": {"description": "Added"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/test_runs/{id}/test_cases": {"post": {"summary": "Add test case to run", "description": "A run is a point-in-time snapshot, never a home: the case is recorded as a copy and keeps the project or suite that owns it, so this does not relocate the source. An unusable path identifier answers `invalid_id`.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"testCaseId": {"type": "string"}}, "required": ["testCaseId"]}}}}, "responses": {"200": {"description": "Added"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/test_runs/{id}/results": {"post": {"summary": "Record test case execution result in run", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestResultRequest"}}}}, "responses": {"200": {"description": "Recorded"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequestOrStatus"}, "404": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/test_runs/{id}/configurations": {"post": {"summary": "Link a configuration to a run", "description": "A run references the top-level configuration instead of embedding a copy of it, so the link records the configuration's identifier and name. An unusable run or `configId` answers `invalid_id`, an unknown one answers `404`, and linking a configuration the run already references answers `409`.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"configId": {"type": "string"}}, "required": ["configId"]}}}}, "responses": {"200": {"description": "Linked"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/test_runs/{id}/configurations/{config_id}": {"delete": {"summary": "Unlink a configuration from a run", "description": "Removes the run's reference to the configuration. An unusable run identifier answers `invalid_id`, and a configuration the run does not reference answers `404`.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/config_id"}], "responses": {"200": {"description": "Unlinked"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/test_cases/{id}": {"get": {"summary": "Read a test case", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead. Test case identifiers are addressed verbatim, so an unusable one is a `404` and never an `invalid_id`.", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Test case document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestCase"}}}}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a test case", "description": "Test case identifiers are addressed verbatim, so an unusable one is a `404` and never an `invalid_id`.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}, "delete": {"summary": "Delete a test case", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead. Test case identifiers are addressed verbatim, so an unusable one is a `404` and never an `invalid_id`.", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_cases/{id}/duplicate": {"$ref": "#/components/x-duplicate-case"},
    "/test_cases/{id}/attachments": {"post": {"summary": "Upload attachment", "description": "The first multipart part is the attachment; its part name is not inspected, but it must carry a filename. A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/AttachmentUpload"}}}}, "responses": {"201": {"description": "Uploaded", "content": {"application/json": {"schema": {"type": "object", "properties": {"message": {"type": "string"}, "filename": {"type": "string"}, "originalName": {"type": "string"}, "size": {"type": "number"}}}}}}, "400": {"$ref": "#/components/responses/AttachmentRejected"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/test_cases/{id}/attachments/{filename}": {"get": {"summary": "Download attachment", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/filename"}], "responses": {"200": {"description": "File content", "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "delete": {"summary": "Delete attachment", "description": "A bare identifier that several parents hold is a conflict; address the case through its parent-scoped route instead.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/filename"}], "responses": {"200": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/test_cases/{id}/steps/{step_index}/attachments": {"get": {"summary": "List step attachments", "description": "Returns the metadata recorded for the addressed structured step, an empty array when it carries none. The index walks the case's `steps` array, where a plain string step has no attachments. A bare identifier that several parents hold is a conflict, and a case addressed by an unusable identifier answers `404`, never `400`.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/step_index"}], "responses": {"200": {"description": "Step attachment metadata", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/StepAttachment"}}}}}, "400": {"$ref": "#/components/responses/InvalidStepIndex"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "post": {"summary": "Upload step attachment", "description": "The first multipart part is the attachment; its part name is not inspected, but it must carry a filename. The metadata is appended to the addressed structured step. A bare identifier that several parents hold is a conflict, and a case addressed by an unusable identifier answers `404`, never `400`.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/step_index"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/AttachmentUpload"}}}}, "responses": {"201": {"description": "Uploaded", "content": {"application/json": {"schema": {"type": "object", "properties": {"message": {"type": "string"}, "filename": {"type": "string"}, "originalName": {"type": "string"}, "size": {"type": "number"}}}}}}, "400": {"$ref": "#/components/responses/StepAttachmentRejected"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/test_cases/{id}/steps/{step_index}/attachments/{filename}": {"delete": {"summary": "Delete step attachment", "description": "Removes the file and its metadata. An unattached filename answers `404`. A bare identifier that several parents hold is a conflict, and a case addressed by an unusable identifier answers `404`, never `400`.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/step_index"}, {"$ref": "#/components/parameters/filename"}], "responses": {"200": {"description": "Deleted"}, "400": {"$ref": "#/components/responses/InvalidStepIndex"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/milestones": {"get": {"summary": "List milestones", "parameters": [{"$ref": "#/components/parameters/filter"}, {"$ref": "#/components/parameters/tags"}], "responses": {"200": {"description": "Milestone IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}}}, "post": {"summary": "Create a milestone", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/milestones/{id}": {"get": {"summary": "Read a milestone", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Milestone document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Milestone"}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a milestone", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}, "delete": {"summary": "Delete a milestone", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/milestones/{id}/duplicate": {"$ref": "#/components/x-duplicate-milestone"},
    "/milestones/{id}/progress": {"get": {"summary": "Get milestone progress", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Milestone progress summary", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MilestoneProgress"}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/configurations": {"get": {"summary": "List configurations", "parameters": [{"$ref": "#/components/parameters/filter"}, {"$ref": "#/components/parameters/tags"}], "responses": {"200": {"description": "Configuration IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}}}, "post": {"summary": "Create a configuration", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "/configurations/{id}": {"get": {"summary": "Read a configuration", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Configuration document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestConfiguration"}}}}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}, "put": {"summary": "Update a configuration", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Updated"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}, "delete": {"summary": "Delete a configuration", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Deleted"}, "400": {"$ref": "#/components/responses/InvalidId"}, "404": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "x-duplicate": {"post": {"summary": "Duplicate resource", "description": "An unusable path identifier answers `invalid_request` here, where `POST /test_suites/{id}/duplicate` answers `invalid_id`. Unknown fields in the body are ignored.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DuplicateRequest"}}}}, "responses": {"201": {"description": "Duplicated"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "x-duplicate-suite": {"post": {"summary": "Duplicate test suite", "description": "An unusable path identifier answers `invalid_id` here, where the project, run, milestone and case duplicate routes answer `invalid_request`. Unknown fields in the body are ignored.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DuplicateRequest"}}}}, "responses": {"201": {"description": "Duplicated"}, "400": {"$ref": "#/components/responses/InvalidIdOrRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "x-duplicate-case": {"post": {"summary": "Duplicate test case", "description": "Unknown fields in the body are ignored.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DuplicateCaseRequest"}}}}, "responses": {"201": {"description": "Duplicated"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "x-duplicate-run": {"post": {"summary": "Duplicate test run without its results", "description": "Unknown fields in the body are ignored.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DuplicateRunRequest"}}}}, "responses": {"201": {"description": "Duplicated"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "x-duplicate-milestone": {"post": {"summary": "Duplicate milestone", "description": "The copy keeps the source's name, dates, status and referenced suites and runs, so it reports the same derived progress; editing or deleting either milestone leaves the other intact. Unknown fields in the body are ignored.", "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"newId": {"type": "string", "description": "Identifier for the copy; derived from the source when omitted"}}}}}}, "responses": {"201": {"description": "Duplicated"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/BodyTooLarge"}}}},
    "parameters": {"id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, "filename": {"name": "filename", "in": "path", "required": true, "schema": {"type": "string"}}, "step_index": {"name": "step_index", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 0, "description": "0-based index of the step inside the case's `steps` array"}, "description": "A value that is not a non-negative integer is reported as `invalid_request`."}, "suite_id": {"name": "suite_id", "in": "path", "required": true, "schema": {"type": "string"}}, "case_id": {"name": "case_id", "in": "path", "required": true, "schema": {"type": "string"}}, "config_id": {"name": "config_id", "in": "path", "required": true, "schema": {"type": "string"}}, "filter": {"name": "filter", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Case-insensitive substring filter for resource IDs"}, "tags": {"name": "tags", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Comma-separated tags; a resource matches when it carries at least one of them (case-insensitive). Resources without a tags array never match."}, "configuration": {"name": "configuration", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Only meaningful for test_runs: keeps the runs that link the given configuration identifier. A configuration no run links yields an empty listing."}},
    "schemas": {"TestRun": {"type": "object", "additionalProperties": false, "description": "A point-in-time snapshot of the suites, cases and results a run recorded. The snapshot embeds a copy of each referenced document, so a later edit to the source leaves the run unchanged.", "properties": {"testRunId": {"type": "string"}, "timestamp": {"type": "string", "description": "Unix seconds rendered as a string, as written by this API; a client-supplied value is stored verbatim, so the field is not necessarily an ISO-8601 date."}, "name": {"type": "string"}, "projects": {"type": "array", "items": {"$ref": "#/components/schemas/Project"}}, "testSuites": {"type": "array", "items": {"$ref": "#/components/schemas/TestSuite"}}, "testCases": {"type": "array", "items": {"$ref": "#/components/schemas/TestCase"}}, "results": {"type": "array", "items": {"$ref": "#/components/schemas/TestCaseResult"}}, "tags": {"type": "array", "items": {"type": "string"}}, "configurations": {"type": "array", "items": {"$ref": "#/components/schemas/TestConfiguration"}}}, "required": ["testRunId", "timestamp"]}, "DuplicateRequest": {"type": "object", "properties": {"newId": {"type": "string", "description": "Identifier for the copy; derived from the source when omitted"}, "newName": {"type": "string", "description": "Name for the copy; the source name is kept when omitted"}}}, "DuplicateCaseRequest": {"type": "object", "properties": {"newId": {"type": "string", "description": "Identifier for the copy; derived from the source when omitted"}, "newTitle": {"type": "string", "description": "Title for the copy; the source title is kept when omitted"}}}, "DuplicateRunRequest": {"type": "object", "properties": {"newId": {"type": "string", "description": "Identifier for the copy; derived from the source when omitted"}}}, "AttachmentUpload": {"type": "object", "description": "The first multipart part is the attachment. Its part name is not inspected, so any name works, but the part must carry a filename; a part without one is reported as `missing_file`.", "properties": {"file": {"type": "string", "format": "binary", "description": "Conventional part name; the handler accepts any."}}}, "Attachment": {"type": "object", "additionalProperties": false, "properties": {"filename": {"type": "string"}, "originalName": {"type": "string"}, "mimeType": {"type": "string"}, "size": {"type": "number"}, "uploadedAt": {"type": "string"}}, "required": ["filename", "originalName", "mimeType", "size"]}, "StepAttachment": {"type": "object", "additionalProperties": false, "description": "Metadata of a file attached to one structured step. Unlike `Attachment` it carries no `uploadedAt`.", "properties": {"filename": {"type": "string"}, "originalName": {"type": "string"}, "mimeType": {"type": "string"}, "size": {"type": "number"}}, "required": ["filename", "originalName", "mimeType", "size"]}, "TestStep": {"type": "object", "additionalProperties": false, "properties": {"action": {"type": "string"}, "expectedResult": {"type": "string"}, "attachments": {"type": "array", "items": {"$ref": "#/components/schemas/StepAttachment"}}}, "required": ["action"]}, "TestCase": {"type": "object", "additionalProperties": false, "properties": {"testCaseId": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "preconditions": {"type": "string"}, "steps": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/components/schemas/TestStep"}]}}, "expectedResult": {"type": "string"}, "priority": {"type": "string", "enum": ["Low", "Medium", "High", "Critical"]}, "severity": {"type": "string", "enum": ["Trivial", "Minor", "Major", "Critical"]}, "testType": {"type": "string"}, "exploratory": {"type": "boolean"}, "attachments": {"type": "array", "items": {"$ref": "#/components/schemas/Attachment"}}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["testCaseId", "title", "expectedResult"]}, "TestResultRequest": {"type": "object", "description": "The execution result recorded for one case in a run. Unknown fields are ignored, and a `timestamp` supplied by the client is stored verbatim.", "properties": {"testCaseId": {"type": "string"}, "status": {"type": "string", "enum": ["Passed", "Failed", "Blocked", "Untested", "Retest"]}, "timestamp": {"type": "string", "description": "Defaults to the current time in Unix seconds, rendered as a string"}, "notes": {"type": "string"}}, "required": ["testCaseId", "status"]}, "TestCaseResult": {"type": "object", "additionalProperties": false, "properties": {"testCaseId": {"type": "string"}, "status": {"type": "string", "enum": ["Passed", "Failed", "Blocked", "Untested", "Retest"]}, "timestamp": {"type": "string", "description": "Unix seconds rendered as a string, as written by this API; a client-supplied value is stored verbatim, so the field is not necessarily an ISO-8601 date."}, "notes": {"type": "string"}, "attachments": {"type": "array", "items": {"$ref": "#/components/schemas/Attachment"}}}, "required": ["testCaseId", "status", "timestamp"]}, "Milestone": {"type": "object", "additionalProperties": false, "properties": {"milestoneId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "startDate": {"type": "string", "format": "date"}, "targetDate": {"type": "string", "format": "date"}, "status": {"type": "string"}, "testSuiteIds": {"type": "array", "items": {"type": "string"}}, "testRunIds": {"type": "array", "items": {"type": "string"}}}, "required": ["milestoneId", "name"]}, "MilestoneProgress": {"type": "object", "properties": {"milestoneId": {"type": "string"}, "totalCases": {"type": "integer"}, "passed": {"type": "integer"}, "failed": {"type": "integer"}, "blocked": {"type": "integer"}, "untested": {"type": "integer"}, "retest": {"type": "integer"}, "passPercentage": {"type": "number"}}, "required": ["milestoneId", "totalCases", "passed", "failed", "blocked", "untested", "retest", "passPercentage"]}, "TestConfiguration": {"type": "object", "additionalProperties": false, "properties": {"configId": {"type": "string"}, "name": {"type": "string"}, "browser": {"type": "string"}, "os": {"type": "string"}, "device": {"type": "string"}, "resolution": {"type": "string"}}, "required": ["configId", "name"]}, "TestSuite": {"type": "object", "additionalProperties": false, "description": "A test suite document. The stored marker keeps `testCases` empty; reads fill it with the cases the suite folder holds.", "properties": {"suiteId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "testCases": {"type": "array", "items": {"$ref": "#/components/schemas/TestCase"}}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["suiteId", "name"]}, "Project": {"type": "object", "additionalProperties": false, "description": "A project document. Reads replace `testSuites` with the suites the project holds (each carrying its cases) and add `testCases` for the cases held directly — a response-only field, omitted when the project owns no case directly.", "properties": {"projectId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "testSuites": {"type": "array", "items": {"$ref": "#/components/schemas/TestSuite"}}, "testCases": {"type": "array", "items": {"$ref": "#/components/schemas/TestCase"}}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["projectId", "name"]}, "CompositionRequest": {"type": "object", "description": "Creation-or-placement body shared by the parent-scoped collection routes. A body with `name` (suite) or `title` (case) creates: the new suite is identified as `<name>.json`, the new case by its `testCaseId`, and `expectedResult` is required alongside a case `title`. Otherwise the body names an existing `suiteId`/`testCaseId` to place that child here, with `mode` choosing copy (the default) or move. `mode` alongside the fields that create is a 400, as is a `mode` other than `copy` or `move`. Fields the reading in use does not know are ignored, so the schema does not claim `additionalProperties: false`.", "properties": {"name": {"type": "string", "description": "Creation: the suite name; the identifier is always `<name>.json`"}, "suiteId": {"type": "string", "description": "Placement: the existing suite to copy or move here. Ignored when the body creates."}, "title": {"type": "string", "description": "Creation: the case title"}, "testCaseId": {"type": "string", "description": "Creation: the identifier of the new case. Placement: the existing case to copy or move here"}, "expectedResult": {"type": "string", "description": "Creation: the result the case expects; required alongside `title`"}, "mode": {"type": "string", "enum": ["copy", "move"], "default": "copy", "description": "Placement only: `copy` duplicates the child into this parent and keeps the source in place (the default); `move` relocates it"}}}, "CompositionResponse": {"type": "object", "properties": {"message": {"type": "string"}, "id": {"type": "string"}}, "required": ["message", "id"]}, "Error": {"type": "object", "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}},
    "responses": {"Error": {"description": "Structured error envelope: `{\"error\": {\"code\": ..., \"message\": ...}}`", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "InvalidId": {"description": "`invalid_id`: an identifier must be a single path component ending in `.json`. Test cases are addressed verbatim and answer `404` instead, and the duplicate routes differ as their own descriptions record.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "InvalidRequest": {"description": "`invalid_request`: the body was rejected — an unknown or missing field, an identifier the body supplies that is not a single `.json` component, or a name-only payload that omits what creation needs.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "InvalidIdOrRequest": {"description": "`invalid_id` for an identifier in the path or the body that is not a single `.json` component, or `invalid_request` for a rejected body.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "InvalidIdOrRequestOrStatus": {"description": "`invalid_id` for an unusable identifier, `invalid_request` for a missing or rejected field, or `invalid_status` when `status` is not `Passed`, `Failed`, `Blocked`, `Untested` or `Retest`.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "AttachmentRejected": {"description": "The upload route's 400s. `invalid_multipart` when the multipart body cannot be parsed and `missing_file` when no part carries a filename, both as the error envelope; but the multipart extractor rejects a request that is not valid `multipart/form-data` before the handler runs, and that answer is plain text — `Invalid \\`boundary\\` for \\`multipart/form-data\\` request` — not the envelope.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}, "text/plain": {"schema": {"type": "string"}}}}, "InvalidStepIndex": {"description": "`invalid_request`: the step index is not a non-negative integer, is beyond the end of the case's `steps` array, or names a plain string step rather than a structured one.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "StepAttachmentRejected": {"description": "The step upload route's 400s. `invalid_request` when the step index is unusable, `invalid_multipart` when the multipart body cannot be parsed and `missing_file` when no part carries a filename, all as the error envelope; but the multipart extractor rejects a request that is not valid `multipart/form-data` before the handler runs, and that answer is plain text.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}, "text/plain": {"schema": {"type": "string"}}}}, "BodyTooLarge": {"description": "Every request is capped at 50 MiB by the router, before the handler runs: the answer is plain text — `length limit exceeded` — never the error envelope. Because the router cap and the attachment cap are the same size, the `payload_too_large` envelope the API can still produce is unreachable for attachments, and this plain-text 413 is the only observable one.", "content": {"text/plain": {"schema": {"type": "string"}}}}}
  }
