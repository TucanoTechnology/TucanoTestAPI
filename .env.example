# Environment for `docker compose up` — the `api` service in docker-compose.yml.
#
# Copy this file to `.env` and set the two required values, then start the
# stack. Compose loads `.env` automatically from this directory:
#
#     cp .env.example .env
#     # edit .env, then:
#     docker compose up -d --build
#
# `.env` is gitignored (see .gitignore). It holds a signing secret, so it must
# never be committed — this committed template is the only tracked copy.

# TUCANO_AUTH_REQUIRED: authentication is on by default; docker-compose.yml
# applies the default when this is unset. Set it to `false` to run the stack
# anonymously, which is only safe on a machine nothing else can reach.
#TUCANO_AUTH_REQUIRED=false

# TUCANO_LOCK_TIMEOUT_MS: how long, in milliseconds, a write waits for the data
# volume's advisory lock before it is refused with `503 lock_timeout`. Defaults
# to 5000. Raise it if a slow filesystem refuses writes that would have
# succeeded; a value that is not a whole number stops the API at startup.
#TUCANO_LOCK_TIMEOUT_MS=5000

# TUCANO_JWT_SECRET (required): the HS256 signing secret, at least 32 bytes.
# Generate one with:
#   node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("base64url"))'
TUCANO_JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-bytes

# TUCANO_BOOTSTRAP_USERNAME and TUCANO_BOOTSTRAP_PASSWORD: the first
# `systemAdmin` account, created on a data directory that holds no accounts.
# The pair is only acted on once; change the password afterwards, or remove the
# two lines once the account exists.
TUCANO_BOOTSTRAP_USERNAME=admin
TUCANO_BOOTSTRAP_PASSWORD=replace-me-too

# Request guardrails (#103): the three ceilings the server enforces at startup,
# environment-only like TUCANO_LOCK_TIMEOUT_MS. A whole number; anything else
# stops the server rather than guessing. TUCANO_REQUEST_TIMEOUT_MS and
# TUCANO_MAX_CONCURRENCY take an explicit 0 to switch that guard off on purpose.
#TUCANO_MAX_BODY_BYTES=52428800
#TUCANO_REQUEST_TIMEOUT_MS=300000
#TUCANO_MAX_CONCURRENCY=128
